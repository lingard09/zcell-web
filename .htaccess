# 보안 응답 헤더 (모의해킹 발견: zcell.co.kr에 보안 헤더 부재)
# mod_headers 없을 때 사이트가 500 나지 않도록 IfModule로 감싼다.
<IfModule mod_headers.c>
    # HTTPS 강제 기억 (AutoSSL 적용 상태). subdomains/preload는 보수적으로 제외.
    Header always set Strict-Transport-Security "max-age=31536000"
    # MIME 스니핑 차단
    Header always set X-Content-Type-Options "nosniff"
    # 클릭재킹 차단 (같은 출처 프레임만 허용)
    Header always set X-Frame-Options "SAMEORIGIN"
    # 레퍼러 최소화
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # 불필요한 브라우저 기능 차단
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 참고: Content-Security-Policy는 아직 넣지 않음.
# 대시보드가 네이버 지도(런타임에 여러 *.naver.net/*.pstatic.net 동적 로드),
# Chart.js(cdn.jsdelivr.net), API(ngrok)를 불러오므로, 도메인 허용목록을 완전히
# 확정해 페이지별로 검증한 뒤 별도로 추가해야 한다. 잘못 잡으면 지도/차트가 깨진다.
